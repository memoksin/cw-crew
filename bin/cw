#!/usr/bin/env bash
# cw — run one headless Claude worker. Task on stdin, report on stdout, one meta line on stderr.
#   cw scout|coder|reviewer [-M tier] [-C dir] [-W name [-K path]...] [-r session_id] [-t timeout_s] [-e auto|low|medium|high] [-w] [-f file]... [-a rule]... [-D dir]... < task.md
#   -T cmd: acceptance command, run by cw in the worker's dir after a clean finish; result in the meta line (accept=pass|FAIL).
#   A coder that hits the turn limit is resumed once with a "continue" message (CW_AUTO_CONTINUE, default 1), only if that
#   run changed files and under half of its tool calls failed; otherwise it stops with error_max_turns for the lead.
#   -W name: run in a git worktree outside the repo (cwwt create name; reused if it exists). -K: extra ignored path to clone
#     into it (besides <repo>/.cw-copy). Merge back with: cwwt diff|apply|rm name. A resume (-r) returns to the run's dir.
#   -M tier: flash|sonnet46|opus46 (Antigravity CLI, Google AI quota) or haiku|sonnet|opus (Claude). See the tier block.
#   -D dir: extra directory the worker may read (repeatable; e.g. screenshots under /tmp for a review).
#   -a rule: extra --allowedTools rule the lead approved after a PERMISSION request (e.g. -a 'Bash(rm /abs/file)').
#   reviewer: read-only, no web. cw inlines the diff to review: -W name = that worktree's changes (cwwt diff),
#     -B ref = changes since the merge base with ref, else uncommitted changes (untracked included). -f = specs.
# Whole body in one { } block: bash parses it all before running, so editing this file cannot break running workers.
{
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
for b in claude jq perl; do command -v "$b" >/dev/null || { echo "cw: needs $b on PATH" >&2; exit 2; }; done
# A native jq.exe writes CRLF under Git Bash unless given --binary (jq >= 1.7); the CR would end up in $(...) values and run files.
[ "$(jq -nr '"a"' 2>/dev/null)" = a ] || { command jq -b -n . >/dev/null 2>&1 && jq() { command jq -b "$@"; }; }
# Run a command with a time limit; rc 142 on timeout (GNU timeout says 124). No timeout(1) on stock macOS: perl alarm there.
tlimit() {
  local t=$1 r; shift
  if command -v timeout >/dev/null && timeout 5 true 2>/dev/null; then
    timeout "$t" "$@"; r=$?; [ $r -eq 124 ] && r=142; return $r
  fi
  perl -e 'alarm shift; exec @ARGV' "$t" "$@"
}

usage() { echo "usage: cw scout|coder|reviewer [-M tier] [-C dir] [-W name [-K path]...] [-r sid] [-t sec] [-e auto|low|medium|high] [-w] [-f file]... [-a rule]... [-D dir]... [-B ref] < task" >&2; exit 2; }
role=${1:-}; shift || true
case $role in scout|coder|reviewer) ;; *) usage ;; esac
base=""; ask=""; dir=$PWD; dir_set=""; resume=""; tmo=""; web=""; files=(); effort=auto; granted=(); wtname=""; keep=(); accept=""; adddirs=(); tier=""
while getopts "C:r:t:wf:e:a:W:K:T:D:B:M:" o; do
  case $o in B) base=$OPTARG ;; C) dir=$OPTARG; dir_set=1 ;; T) accept=$OPTARG ;; W) wtname=$OPTARG ;; K) keep+=(-K "$OPTARG") ;; r) resume=$OPTARG ;; t) tmo=$OPTARG ;; w) web=1 ;; f) files+=("$OPTARG") ;; e) effort=$OPTARG ;; a) granted+=("$OPTARG") ;; D) adddirs+=(--add-dir "$OPTARG") ;; M) tier=$OPTARG ;; *) usage ;; esac
done
[ "$role" = reviewer ] && [ -n "$web" ] && { echo "cw: reviewer has no web" >&2; exit 2; }
[ -t 0 ] && [ "$role" != reviewer ] && { echo "cw: task must come on stdin" >&2; exit 2; }
[ -n "$tmo" ] || { [ "$role" = coder ] && tmo=${CW_TIMEOUT:-3600} || tmo=${CW_TIMEOUT:-1200}; }   # coders get 60 min, scouts and reviewers 20
task=""; [ -t 0 ] || task=$(cat)
[ "$role" = reviewer ] && [ -z "$task" ] && task="Review the diff below."
[ -n "$task" ] || { echo "cw: empty task" >&2; exit 2; }
case $effort in auto|low|medium|high|xhigh|max) ;; *) usage ;; esac
logdir=${CW_LOG_DIR:-$HOME/.claude/cw-runs}; mkdir -p "$logdir/dirs"
if [ -n "$wtname" ] && [ "$role" = reviewer ]; then
  dir=$(cd "$dir" && "$here/cwwt" path "$wtname") || { echo "cw: no worktree $wtname to review" >&2; exit 2; }
elif [ -n "$wtname" ]; then
  dir=$(cd "$dir" && "$here/cwwt" create "$wtname" "${keep[@]+"${keep[@]}"}") || { echo "cw: worktree setup failed" >&2; exit 2; }
elif [ -n "$resume" ] && [ -z "$dir_set" ] && [ -f "$logdir/dirs/$resume" ]; then
  dir=$(cat "$logdir/dirs/$resume")   # a resumed session must run where it ran before
fi
spec=$task
# Tree snapshot of the work dir (tracked + untracked, no ignored), to tell real progress from looping.
snap() { git -C "$dir" rev-parse -q --git-dir >/dev/null 2>&1 || return 0; local i; i=$(mktemp)
  cp "$(git -C "$dir" rev-parse --path-format=absolute --git-path index)" "$i" 2>/dev/null
  GIT_INDEX_FILE=$i git -C "$dir" add -A >/dev/null 2>&1; GIT_INDEX_FILE=$i git -C "$dir" write-tree 2>/dev/null; rm -f "$i"; }

# Inline files with code, so the worker spends no tool turns (each turn resends the whole context) reading them.
for f in "${files[@]+"${files[@]}"}"; do
  case $f in /*|[A-Za-z]:[/\\]*) p=$f ;; *) p=$dir/$f ;; esac   # absolute: POSIX or drive letter
  [ -f "$p" ] || { echo "cw: no such file: $f" >&2; exit 2; }
  task+=$'\n\n'"<file path=\"$f\">"$'\n'"$(cat "$p")"$'\n</file>'
done

# A reviewer gets its diff inline (a fresh run only; a resume already has it).
if [ "$role" = reviewer ] && [ -z "$resume" ]; then
  if [ -n "$wtname" ]; then d=$(cd "$dir" && "$here/cwwt" diff "$wtname") || exit 2; src="worktree $wtname"
  else
    git -C "$dir" rev-parse -q --git-dir >/dev/null 2>&1 || { echo "cw: reviewer needs a git repo" >&2; exit 2; }
    from=HEAD; src="uncommitted changes"
    [ -n "$base" ] && { from=$(git -C "$dir" merge-base "$base" HEAD) || { echo "cw: no merge base with $base" >&2; exit 2; }; src="changes since $base"; }
    d=$(git -C "$dir" diff "$from" "$(snap)")
  fi
  [ -n "$d" ] || { echo "cw: nothing to review ($src)" >&2; exit 2; }
  cap=${CW_REVIEW_MAX:-60000}
  [ ${#d} -gt "$cap" ] && d="${d:0:$cap}"$'\n'"[diff cut at $cap chars: Read the remaining files yourself]"
  task+=$'\n\n'"<diff of=\"$src\">"$'\n'"$d"$'\n</diff>'
fi

report="Final message is your report: English, terse, max 15 lines. No code dumps unless asked. Line 1 is the status: DONE, PARTIAL or BLOCKED, plus any missed target or failing check. DONE only if every check the task asks for ran and passed; a FAIL line, a skipped check or a missed target means PARTIAL. Mark claims you did not check NOT CHECKED. The report must stand alone: never answer with 'my earlier report stands'. If a real ambiguity or a blocker stops you (a decision that is not yours, missing access, conflicting facts), stop and make the last line of your report: QUESTION: <one concrete question>. You will be resumed with the answer. If a denied call was only an extra check the task did not ask for, skip it and mark that gap NOT CHECKED. If a tool call the task needs is denied by permissions, do not retry it and do not work around it with another command that has the same effect: stop and make the last line of your report: PERMISSION: <Tool>(<exact command or path>) -- <why the task needs it>. You will be resumed with APPROVED (that exact call is then allowed: run it exactly as written) or DENIED with a reason and an alternative."
# Scouts and reviewers: read-only Bash.
ro_allow=("Bash(rg *)" "Bash(grep *)" "Bash(fd *)" "Bash(eza *)" "Bash(ls *)" "Bash(wc *)" "Bash(head *)" "Bash(tail *)" "Bash(sed -n *)"
          "Bash(git log*)" "Bash(git show*)" "Bash(git diff*)" "Bash(git status*)" "Bash(git blame*)")

# Coder rules, also turned into agy deny rules below. Risky but sometimes needed: in -p mode an "ask" rule is a denial,
# which the worker turns into a PERMISSION request for the lead (see SKILL.md). Hard-never actions stay in --disallowedTools.
coder_ask='["Bash(sudo *)","Bash(rm -r *)","Bash(rm -fr *)","Bash(rm -R *)","Bash(chmod *)","Bash(chown *)","Bash(kill *)",
  "Bash(git checkout *)","Bash(git restore *)","Bash(git stash *)","Bash(git rebase *)","Bash(git branch -D *)","Bash(git worktree *)",
  "Bash(brew *)","Bash(npm install -g *)","Bash(pip install *)","Bash(pip3 install *)","Bash(uv tool *)","Bash(sh)","Bash(bash)","Bash(zsh)",
  "Bash(launchctl *)","Bash(osascript *)","Bash(defaults write *)","Bash(open *)","Bash(crontab *)",
  "Bash(taskkill *)","Bash(powershell*)","Bash(pwsh*)","Bash(cmd *)","Bash(cmd.exe*)","Bash(reg add *)","Bash(reg delete *)","Bash(reg import *)","Bash(reg.exe *)",
  "Bash(*Remove-Item*)","Bash(rd *)","Bash(del *)","Bash(rmdir /s*)","Bash(rmdir /S*)","Bash(rmdir //s*)","Bash(rmdir //S*)",
  "Bash(schtasks*)","Bash(sc *)","Bash(sc.exe *)","Bash(setx *)","Bash(wsl*)","Bash(winget *)","Bash(choco *)","Bash(scoop *)",
  "Edit(~/.*)","Write(~/.*)","Edit(~/.claude/**)","Write(~/.claude/**)","Edit(~/Library/**)","Write(~/Library/**)","Edit(~/AppData/**)","Write(~/AppData/**)"]'
hard=("Bash(git commit*)" "Bash(git push*)" "Bash(git reset*)" "Bash(git clean*)" "Bash(git merge*)" "Bash(git cherry-pick*)" "Bash(git revert*)" "Bash(git am*)" "Bash(git pull*)" "Bash(rm -rf*)"
  "Bash(pkill*)" "Bash(killall*)" "Bash(kill -1*)" "Bash(kill -9 -1*)" "Bash(kill -15 -1*)" "Bash(kill 0*)" "Bash(kill -- -*)" "Bash(kill -9 0*)" "Bash(kill -15 0*)" "Bash(kill -KILL *)" "Bash(kill -TERM -*)" "Bash(kill -s *)"
  "Bash(shutdown*)" "Bash(reboot*)" "Bash(halt*)" "Bash(diskutil *)" "Bash(dd *)" "Bash(mkfs*)"
  "Bash(taskkill*/im *)" "Bash(taskkill*/IM *)" "Bash(taskkill*/fi *)" "Bash(taskkill*/FI *)" "Bash(diskpart*)" "Bash(format *:*)" "Bash(format.com *)" "Bash(bcdedit*)"
  "Bash(vssadmin *delete*)" "Bash(vssadmin *Delete*)" "Bash(vssadmin *DELETE*)" "Bash(cipher*/w*)" "Bash(cipher*/W*)")
if [ "$role" = scout ]; then
  model=${CW_SCOUT_MODEL:-claude-haiku-5-5}
  sp="You are a read-only research worker for an orchestrator. Do only the task. Bash allows only read-only commands (rg, grep, fd, eza, ls, wc, head, tail, sed -n, git log/show/diff/status/blame); others are denied. Search with rg (or grep) and read only the lines you need. Files given inline are already read. Cite facts as file:line or URL, only lines you read in this run; mark anything unverified. A 'none found' or 'complete' claim names the search command and its hit count. $report"
  tools=Read,Bash; allow=("${ro_allow[@]}")
  [ -n "$web" ] && { tools+=,WebFetch,WebSearch; allow+=(WebFetch WebSearch); }
  maxt=40
  args=(--permission-mode dontAsk --max-turns $maxt --allowedTools "${allow[@]}")
elif [ "$role" = reviewer ]; then
  model=${CW_REVIEWER_MODEL:-claude-sonnet-5-5}
  sp="You are a read-only code reviewer for an orchestrator. You did not write this change: judge the inline diff fresh against the task and any spec. Bash allows only read-only commands (rg, grep, ls, sed -n, git log/show/diff/blame); read only what you need to confirm a finding. Report real defects: wrong behavior, broken contract or spec rule, missing test for changed behavior, security. Skip style unless a spec asks for it. Report: English, max 15 lines, no praise. Line 1: 'DONE review: N blocker, M suggest' or 'DONE review: clean'; 'BLOCKED <why>' if you could not review. Then one line per finding: 'BLOCKER path:line - problem; fix' or 'SUGGEST path:line - ...'. Cite only lines you read; mark unchecked ones UNSURE. If a real ambiguity stops you, last line: QUESTION: <one question>."
  tools=Read,Bash; allow=("${ro_allow[@]}")
  maxt=20
  args=(--permission-mode dontAsk --max-turns $maxt --allowedTools "${allow[@]}")
else
  model=${CW_CODER_MODEL:-claude-sonnet-5-5}
  sp="You are a coding worker for an orchestrator. Do only the task, inside the named scope. Files given inline are already read, but Read a file before you Edit it. Make the smallest change that meets the task and match the surrounding style. Run the acceptance commands and fix failures. Never make a test pass by weakening it (raising a timeout, cap or threshold, dropping or rewriting an assertion): if a test looks wrong, keep it and say why, or ask. Never git commit, push, reset, clean, merge, cherry-pick, revert, am or pull, and never delete files you did not create. Never kill processes by name or pattern (pkill, killall, kill -1, kill 0): on macOS a pattern like 'pkill -f cat' also matches /Applications/... and kills every app the user has open. Stop only processes you started, with: $here/cwkill PID (plain kill is not allowed; cwkill refuses any process outside your own process tree). To wait for something, prefer running it in the foreground; otherwise poll with 'sleep 5' between checks. Never build a delay from reads of /dev/zero, /dev/urandom or spin loops: they burn a full CPU core and grow memory. $report List files changed (also files outside the scope that a tool or import rewrote), commands run with results, test changes with before/after values, open issues."
  tools=Read,Edit,Write,Bash
  ask=$coder_ask
  maxt=${CW_MAX_TURNS:-80}
  args=(--permission-mode auto --max-turns "$maxt" --allowedTools "Bash($here/cwkill *)" --disallowedTools "${hard[@]}")
fi
[ -n "$resume" ] && args+=(--resume "$resume")
if [ ${#granted[@]} -gt 0 ]; then
  args+=(--allowedTools "${granted[@]}")
  # An ask rule beats an allow rule, so drop the ask rules a granted call falls under.
  ask=$(jq -c --args '[.[] as $r | select(all($ARGS.positional[]; . as $g |
      ($r | capture("^(?<t>[A-Za-z]+)\\((?<p>.*)\\)$")) as $m
      | ($g | capture("^(?<t>[A-Za-z]+)\\((?<c>.*)\\)$")) as $n
      | ($m.t != $n.t) or (($m.p | rtrimstr("*") | rtrimstr(" ")) as $pre | ($n.c | startswith($pre)) | not)))
      | $r]' "${granted[@]}" <<< "${ask:-[]}")
fi

# Tier (-M): flash, sonnet46, opus46 run on the Antigravity CLI (agy; Google AI plan quota) and need CW_AGY=1;
# haiku, sonnet, opus run on Claude. Default: coder sonnet; scout flash with CW_AGY=1, else (and with -w) haiku;
# reviewer keeps CW_REVIEWER_MODEL unless -M names a Claude tier.
# An agy tier falls back to the role's Claude model when agy tiers are off, the run needs -w or -a, agy is missing,
# or no home in CW_AGY_HOME has quota (5h and weekly) at or above CW_AGY_MIN percent.
[ -n "$tier" ] || [ "$role" = reviewer ] || { if [ "$role" = coder ]; then tier=sonnet; elif [ -n "$web" ] || [ "${CW_AGY:-0}" != 1 ]; then tier=haiku; else tier=flash; fi; }
agy=""
[ "$role" = reviewer ] && case $tier in flash|sonnet46|opus46) echo "cw: agy tiers are for scouts and coders; reviewer stays on Claude" >&2; tier="" ;; esac
case $tier in
  "") ;;
  flash) agy=gemini-3.8-flash-high ;; sonnet46) agy=claude-sonnet-4-6 ;; opus46) agy=claude-opus-4-6-thinking ;;
  haiku) model=${CW_SCOUT_MODEL:-claude-haiku-5-5} ;; sonnet) model=${CW_CODER_MODEL:-claude-sonnet-5-5} ;; opus) model=claude-opus-5-5 ;;
  *) usage ;;
esac
if [ -n "$agy" ]; then
  # agy keeps settings and login under $HOME: each home in CW_AGY_HOME is a HOME of symlinks to the real one (see
  # cwagy) with cw's own settings.json (deny rules) and agents/. Tool commands see this HOME too.
  # Homes are tried in order: the first with quota left runs the task; a resume goes back to its session's home.
  why=""; ah=""
  if [ "${CW_AGY:-0}" != 1 ]; then why="agy tiers are off (CW_AGY=1 turns them on)"
  elif [ -n "$web" ]; then why="agy tiers have no web tools"
  elif [ ${#granted[@]} -gt 0 ]; then why="-a grants need a Claude tier"
  elif ! command -v agy >/dev/null; then why="agy not on PATH"
  elif [ -n "$resume" ] && [ -f "$logdir/dirs/$resume.agy" ]; then ah=$(cat "$logdir/dirs/$resume.agy")
  else
    case $agy in gemini*) bucket="Gemini Models" ;; *) bucket="Claude and GPT models" ;; esac
    IFS=: read -ra homes <<< "${CW_AGY_HOME:-$HOME/.claude/cw-agy}"; kind=first; notes=""
    for h in "${homes[@]}"; do
      "$here/cwagy" prep "$h" "$kind"; kind=extra
      quota=$(cd "$h" && HOME=$h tlimit 15 agy -p /usage < /dev/null 2>/dev/null | awk -F'\t' -v b="$bucket" '$1 == b { v = $3 + 0; if (m == "" || v < m) m = v } END { print m }')
      if [ -z "$quota" ]; then notes+=" ${h##*/}: no quota (signed in? cwagy login $h)"
      elif [ "$quota" -lt "${CW_AGY_MIN:-5}" ]; then notes+=" ${h##*/}: $quota%"
      else ah=$h; break; fi
    done
    [ -n "$ah" ] || why="no agy home has '$bucket' quota left:$notes"
  fi
  if [ -n "$why" ]; then
    [ -n "$resume" ] && { echo "cw: $why; an agy session cannot resume on Claude: rerun it fresh" >&2; exit 2; }
    [ "$role" = scout ] && model=${CW_SCOUT_MODEL:-claude-haiku-5-5} || model=${CW_CODER_MODEL:-claude-sonnet-5-5}   # reviewer never gets here
    echo "cw: $why, using $model" >&2; agy=""
  fi
fi
if [ -n "$agy" ]; then
  model=agy/$agy
  # agy has no read-scope rule that works for custom agents in headless mode, so runs skip permission prompts: the
  # agent's tool list and the deny rules (cw's ask and hard rules, prefix-matched, so never wider) are the guard.
  deny=()
  while IFS= read -r r; do
    case $r in
      Bash\(*\*\)) p=${r#Bash(}; p=${p%)}; p=${p#\*}; p=${p%%\**}; p=${p%% }; [ -n "$p" ] && deny+=("command($p)") ;;
      Edit\(~/*|Write\(~/*) p=${r#*(~/}; p=${p%%\**}; p=${p%)}; p=${p%/}
        if [ "$p" = . ]; then for e in "$HOME"/.[!.]*; do deny+=("write_file($e)" "write_file($ah/${e##*/})"); done
        else deny+=("write_file($HOME/$p)" "write_file($ah/$p)"); fi ;;
    esac
  done < <(printf '%s\n' "${hard[@]}"; jq -r '.[]' <<< "$coder_ask")
  deny+=("command(bash -c)" "command(sh -c)" "command(zsh -c)" "command(eval)")   # bare bash/sh/zsh rules: their -c bypass
  put() { [ "$(cat "$1" 2>/dev/null)" = "$2" ] || { printf '%s\n' "$2" > "$1.$$" && mv "$1.$$" "$1"; }; }   # atomic: runs share it
  put "$ah/.gemini/antigravity-cli/settings.json" "$(jq -n --args '{permissions: {deny: ($ARGS.positional | unique)}}' "${deny[@]}")"
  # Gemini and the 4.6 models follow short prompts loosely: name the method, the stop point and the citation rule.
  pin="Open and edit files only inside the workspace the task names; never touch the home directory, dotfiles or other projects. Cite path:line as plain text, no markdown links. No preamble, no restating the task."
  if [ "$role" = scout ]; then
    aname=cw-scout; atools="view_file, grep_search, find_by_name, list_dir"
    sp="You are a read-only research worker for an orchestrator. Do only the task. $pin Method: locate with grep_search or find_by_name, then view_file a line range around each hit; do not read whole large files. Files given inline in the task are already read: do not open them again. Stop as soon as every question in the task is answered; no extra exploration. Every fact cites path:line from a file you opened in this run; mark anything else NOT CHECKED. Never guess a name, path or number. A 'none found' claim names the search and its hit count. $report"
  else
    aname=cw-coder; atools="view_file, grep_search, find_by_name, list_dir, write_to_file, replace_file_content, multi_replace_file_content, run_command"
    sp="$pin Change only what the task asks: no refactors, renames, reformatting or new comments. After each edit, view the changed lines once to confirm them. $sp"
  fi
  mkdir -p "$ah/.gemini/antigravity-cli/agents"
  put "$ah/.gemini/antigravity-cli/agents/$aname.md" "$(printf -- '---\nname: %s\ndescription: cw-crew %s\ntools: [%s]\n---\n# Instructions\n%s' "$aname" "$role" "$atools" "$sp")"
fi


# Effort: an explicit -e wins; a resume keeps the effort of the run it continues; otherwise, only with CW_JEV=1,
# Jev picks it from the spec (OpenRouter decisions API, ~1 s, ~$0.00002; sends the first 20k chars of the task).
# Jev must be sure (p >= CW_JEV_SURE %, default 70) to pick high; a less sure high runs at medium, since a run that
# falls short is retried higher (on past runs this matched a blind review better: 23/26 vs 20/26).
# agy runs skip Jev: agy takes no --effort.
# Off or any failure: the role default.
effort_src=flag; effort_p=""; effort_jev=""
if [ "$effort" = auto ]; then
  [ "$role" = coder ] && effort=medium || effort=low
  effort_src=default
  prev=""
  [ -n "$resume" ] && prev=$(grep -rlF --include='*.json' "\"session_id\":\"$resume\"" "$logdir" 2>/dev/null | sort | tail -1)
  if [ -n "$prev" ] && [ -f "${prev%.json}.meta" ] && pe=$(jq -re '.effort // empty' "${prev%.json}.meta" 2>/dev/null); then
    effort=$pe; effort_src=resume
  elif [ -z "$agy" ] && [ "${CW_JEV:-0}" = 1 ] && key=${OPENROUTER_API_KEY:-$([ -n "${CW_JEV_KEYCHAIN:-}" ] && security find-generic-password -s "$CW_JEV_KEYCHAIN" -w 2>/dev/null)}; [ -n "${key:-}" ]; then
    req=$(jq -nc --arg m "${CW_JEV_MODEL:-typesafe/jev-1.13}" --arg role "$role" --arg wm "$model" --arg spec "${spec:0:20000}" \
      --arg files "${files[*]+"${files[*]}"}" '{model: $m,
      state: {worker_role: $role,
        worker_model: ($wm + (if $role == "scout" then " (read-only research)" elif $role == "reviewer" then " (read-only diff review)" else " (writes code, runs tests)" end)),
        files_given: $files, task_spec: $spec},
      questions: {effort: {type: "choice",
        instructions: "How much reasoning effort should this headless worker get to finish `task_spec` correctly on the first try? Higher effort costs 2-4x more tokens and time, so pick the lowest level that is still likely to succeed. When torn between two levels, pick the lower one: a run that falls short is retried at a higher effort.",
        criteria: {
          low: "Mechanical or lookup work: one clear answer, a few files, no design decisions (count, grep and list, rename, small single-file function with a given test).",
          medium: "Normal multi-step work: several files or sources to read and connect, or a self-contained feature with edge cases, but the approach is clear.",
          high: "Hard work: cross-file refactor or migration, subtle bug whose cause is unknown, conflicting constraints, or a retry after a failed attempt."}}}}')
    if ans=$(printf '%s' "$req" | curl -sS -m 4 -H "Authorization: Bearer $key" -H 'Content-Type: application/json' \
          --data-binary @- https://openrouter.ai/api/alpha/decisions 2>/dev/null) \
       && pick=$(jq -re '.answers.effort.choice | select(. == "low" or . == "medium" or . == "high")' <<<"$ans" 2>/dev/null); then
      effort=$pick; effort_src=jev; effort_jev=$pick   # before the CW_JEV_SURE step-down
      effort_p=$(jq -r '.answers.effort.probabilities | to_entries | map("\(.key[0:1])\(.value * 100 | floor)") | join(" ")' <<<"$ans")
      sure=$(jq -r --arg c "$pick" '(.answers.effort.probabilities[$c] // 1) * 100 | floor' <<<"$ans")
      [ "$pick" = high ] && [ "$sure" -lt "${CW_JEV_SURE:-70}" ] && effort=medium
    else
      echo "cw: Jev effort pick failed, using $effort" >&2
    fi
  fi
fi
args+=(--effort "$effort" "${adddirs[@]+"${adddirs[@]}"}")
log="$logdir/$(date +%Y%m%d-%H%M%S)-$role-$$"
start=$(date +%s)
tree0=$(snap)
# Nested launches inherit the parent session's vars and can hang or refuse to start.
scrub=(-u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_MESSAGING_SOCKET
       -u CLAUDE_CODE_MESSAGING_TOKEN -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_SESSION_ATTENDED
       -u CLAUDE_CODE_EXECPATH -u CLAUDE_PID -u CLAUDE_EFFORT)
# Workers run tool commands in bash: the user's zsh snapshot brings aliases (ls -> eza --icons) that
# change output and once hung a worker for 8 minutes.
# cmux's claude shim drops ANTHROPIC_API_KEY (workers fall back to the subscription): call the real binary.
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v 'cmux-cli-shims' | paste -sd: -)

# --safe-mode drops CLAUDE.md, skills, plugins, hooks, MCP; --system-prompt replaces the ~2k default one.
# Measured cold start: ~2.9k (scout) / ~3.4k (coder) tokens vs ~75k for a plain `claude -p`.
# language=English: the user-level language setting survives safe mode; English reports are cheaper.
# On timeout the worker dies and rc is 142 (see tlimit).
# Live state for the cw-crew pane: .meta at start, one compact line per step in .events, rc in .done.
title=$(printf '%s' "$task" | perl -ne 's/^\s*(#+\s*)?(goal|task)\s*:?\s*//i; if (/\S/) { print; exit }' | cut -c1-160)
branch=$(git -C "$dir" branch --show-current 2>/dev/null)
jq -nc --arg role "$role" --arg model "$model" --arg session "${CLAUDE_CODE_SESSION_ID:-}" --arg resume "$resume" \
  --arg task "$title" --argjson start "$start" --argjson tmo "$tmo" --argjson web "${web:-0}" --argjson pid $$ --arg effort "$effort" --arg esrc "$effort_src" --arg ep "$effort_p" --arg ej "$effort_jev" --arg name "${CW_NAME:-}" \
  --argjson maxt "$maxt" --arg branch "$branch" --arg wt "$wtname" --argjson cont "${CW_CONT:-0}" \
  '{name:$name,role:$role,model:$model,session:$session,resume:$resume,task:$task,start:$start,tmo:$tmo,web:($web==1),pid:$pid,effort:$effort,effort_src:$esrc,effort_p:$ep,effort_jev:$ej,maxt:$maxt,branch:$branch,wt:$wt,cont:($cont==1)}' \
  > "$log.meta"
# Heartbeat for the pane: stops when cw dies (killed, no .done) or finishes. fds closed so $(cw ...) callers never wait on it.
( while kill -0 $$ 2>/dev/null && [ ! -e "$log.done" ]; do touch "$log.hb"; sleep 30; done ) </dev/null >/dev/null 2>&1 &
# A tool command that outlived its own timeout (e.g. blocked on a full pipe) keeps `claude -p` from
# exiting after its result, so cw never wrote .json. Once the result is in, give claude CW_EXIT_GRACE
# seconds, then stop the leftover processes under it (only this worker's own tree).
( while kill -0 $$ 2>/dev/null && [ ! -e "$log.json" ]; do
    sleep 5
    tail -1 "$log.events" 2>/dev/null | grep -q '"e":"result"' || continue
    sleep "${CW_EXIT_GRACE:-20}"
    [ -s "$log.json" ] && break
    tree=$(ps -A -o pid=,ppid=,command=)
    c=$(awk -v r=$$ '{p[$1]=$2; if ($0 ~ /(^|[ \/])claude -p /) k[$1]=1}
      END {for (x in k) {y=x; while ((y in p) && y != r) y=p[y]; if (y == r) print x}}' <<< "$tree" | head -1)
    [ -n "$c" ] || break
    kids=$(awk -v r="$c" '{p[$1]=$2} END {for (x in p) {y=p[x]; while ((y in p) && y != r) y=p[y]; if (y == r) print x}}' <<< "$tree")
    echo "cw: claude did not exit ${CW_EXIT_GRACE:-20}s after its result; stopping leftover tool processes: $(echo $kids)" >> "$log.err"
    [ -n "$kids" ] && kill $kids 2>/dev/null
    sleep 5; kill -0 "$c" 2>/dev/null && kill "$c" 2>/dev/null
    break
  done ) </dev/null >/dev/null 2>&1 &
ev='fromjson? |
  if .type=="system" and .subtype=="init" then {e:"init", sid:.session_id}
  elif .type=="assistant" then
    (.message.usage // {} | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)) as $ctx
    | (.message.id // "" | .[-8:]) as $mid | .message.content[]? |
    (if .type=="tool_use" then {e:"tool",tool:.name,
      arg:((.input.file_path // .input.path // .input.command // .input.pattern // .input.query // .input.url // "")|tostring|.[0:120])}
    elif .type=="thinking" then {e:"think"} elif .type=="text" then {e:"text"} else empty end) | .ctx=$ctx | .mid=$mid
  elif .type=="user" then .message.content[]? | select(.type=="tool_result") |
    {e:(if .is_error then (if (.content|tostring|test("permission|denied|not allowed";"i")) then "denied" else "error" end) else "ok" end)}
  elif .type=="result" then {e:"result",ok:(.is_error|not),sub:.subtype,sid:.session_id,turns:.num_turns,
    denied:(.permission_denials|length),out:.usage.output_tokens,cost:.total_cost_usd,
    cin:.usage.cache_read_input_tokens,nin:((.usage.input_tokens // 0) + (.usage.cache_creation_input_tokens // 0)),
    win:([.modelUsage[]?.contextWindow // empty] | max)}
  else empty end | .t=(now*1000|floor)'
if [ -n "$agy" ]; then
  # agy stream-json -> the same compact events, and its result -> a Claude-shaped .json so everything below works unchanged.
  agyev='fromjson? |
    if .event=="init" then {e:"init", sid:.conversation_id}
    elif .event=="step_update" then .step_update |
      if .step_type=="tool" then
        if .state=="ACTIVE" then {e:"tool",tool:.tool_name,
          arg:((.tool_info.parameters // {} | .AbsolutePath // .SearchPath // .DirectoryPath // .SearchDirectory // .Query // .Pattern // "")|tostring|.[0:120])}
        elif .state=="DONE" then {e:"ok"} elif .state=="ERROR" then {e:"error"} else empty end
      elif .step_type=="agent_response" and .state=="DONE" then {e:"text",ctx:(.usage.input_tokens // 0)}
      else empty end
    elif .event=="result" then .result | {e:"result",ok:(.status=="SUCCESS" and (.response // "") != ""),sub:(.status|ascii_downcase),
      sid:.conversation_id,turns:.num_turns,denied:(.denied_actions // [] | length),out:.usage.output_tokens,
      cin:.usage.cache_read_tokens,nin:((.usage.input_tokens // 0) - (.usage.cache_read_tokens // 0))}
    else empty end | .t=(now*1000|floor)'
  where="Workspace: $dir"; [ ${#adddirs[@]} -gt 0 ] && where+=" (also readable: $(printf '%s ' "${adddirs[@]}" | sed 's/--add-dir //g'))"
  # Deny rules match the command text, so `git -C . commit` or `python -c "os.system('git push')"` slip past them.
  # This git config, inherited by every process the worker starts, sends any push to a dead URL and leaves git no
  # identity, so commit, merge, rebase, cherry-pick, revert, am and stash fail. Reads and fetch still work.
  (cd "$dir" && tlimit "$tmo" env "${scrub[@]}" -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL -u GIT_COMMITTER_NAME -u GIT_COMMITTER_EMAIL -u EMAIL \
    HOME="$ah" SHELL="$(command -v bash)" GIT_CONFIG_COUNT=3 GIT_CONFIG_KEY_0=url.cw-no-push://.pushInsteadOf GIT_CONFIG_VALUE_0= \
    GIT_CONFIG_KEY_1=user.useConfigOnly GIT_CONFIG_VALUE_1=true GIT_CONFIG_KEY_2=user.name GIT_CONFIG_VALUE_2= agy -p "$where."$'\n\n'"$task" --agent "$aname" --model "$agy" \
    --dangerously-skip-permissions --output-format stream-json "${adddirs[@]+"${adddirs[@]}"}" ${resume:+--conversation "$resume"}) 2> "$log.err" \
    | tee "$log.jsonl" | jq -Rc --unbuffered "$agyev" > "$log.events" 2>/dev/null
  rc=${PIPESTATUS[0]}
  jq -Rc --arg m "$model" 'fromjson? | select(.event=="result") | .result | ((.response // "") == "") as $empty
    | {type:"result", is_error:(.status != "SUCCESS" or $empty),
       subtype:(if .status != "SUCCESS" then (.status|ascii_downcase) elif $empty then "empty_response" else "success" end),
       result:(.response // ""), session_id:.conversation_id, num_turns:.num_turns,
       usage:{input_tokens:((.usage.input_tokens // 0) - (.usage.cache_read_tokens // 0)), cache_creation_input_tokens:0,
         cache_read_input_tokens:(.usage.cache_read_tokens // 0), output_tokens:(.usage.output_tokens // 0)},
       modelUsage:{($m):{}}, permission_denials:(.denied_actions // [] | map({tool_name:.action, tool_input:{display:.display_name}}))}' \
    "$log.jsonl" | tail -1 > "$log.json"
else
printf '%s' "$task" | (cd "$dir" && tlimit "$tmo" env "${scrub[@]}" CLAUDE_CODE_SHELL="$(command -v bash)" \
  claude -p --safe-mode --settings "{\"language\":\"English\",\"permissions\":{\"ask\":${ask:-[]}}}" --model "$model" --output-format stream-json --verbose \
  --system-prompt "$sp" --tools "$tools" "${args[@]}") 2> "$log.err" \
  | tee "$log.jsonl" | jq -Rc --unbuffered "$ev" > "$log.events" 2>/dev/null
rc=${PIPESTATUS[1]}
jq -Rc 'fromjson? | select(.type=="result")' "$log.jsonl" | tail -1 > "$log.json"
fi
sid=$(jq -r '.session_id // empty' "$log.json" 2>/dev/null); [ -n "$sid" ] && printf '%s\n' "$dir" > "$logdir/dirs/$sid"
[ -n "$sid" ] && [ -n "$agy" ] && printf '%s\n' "$ah" > "$logdir/dirs/$sid.agy"   # its conversation lives in that home
# Lines this run changed (untracked files included), for the crew pane.
tree1=$(snap)
if [ -n "$tree0" ] && [ -n "$tree1" ] && [ "$tree0" != "$tree1" ]; then
  git -C "$dir" diff --numstat "$tree0" "$tree1" 2>/dev/null | awk -v t="$(( $(date +%s) * 1000 ))" \
    '{a+=$1; d+=$2; n++} END {printf "{\"e\":\"diff\",\"add\":%d,\"del\":%d,\"files\":%d,\"t\":%s}\n", a, d, n, t}' >> "$log.events"
fi
# Turn limit: resume the same session with a standard message instead of making the lead do it.
# The note below is not a "[cw " line, so cwwait keeps waiting for the final one.
# Only when the segment made progress: files changed and most tool calls did not fail. A worker that
# loops on an error stops here with error_max_turns and the lead decides.
left=${CW_AUTO_CONTINUE:-1}
if [ "$role" = coder ] && [ -n "$sid" ] && [ "$left" -gt 0 ] && [ "$(jq -r '.subtype // ""' "$log.json")" = error_max_turns ] \
   && [ "$tree1" != "$tree0" ] \
   && jq -se '(map(select(.e=="error")) | length) * 2 < (map(select(.e=="ok" or .e=="error")) | length)' "$log.events" >/dev/null 2>&1; then
  # no .done for this segment: the crew pane would toast it as failed; the resumed run (same pid) carries on
  echo "cw: turn limit hit after $(( $(date +%s) - start ))s, auto-continuing sid=$sid ($left left)" >&2
  again=(-r "$sid" -t "$tmo"); [ -n "$accept" ] && again+=(-T "$accept")
  for g in "${granted[@]+"${granted[@]}"}"; do again+=(-a "$g"); done
  CW_AUTO_CONTINUE=$((left - 1)) CW_CONT=1 exec "$0" coder "${again[@]}" <<< "You hit the turn limit mid-task. Continue exactly where you stopped; do not redo finished work. Finish the task, run the acceptance commands, then send the full report the task asks for."
fi
# A worker that ends on QUESTION: waits to be resumed (-r sid) with the answer: rc 3, question in .ask.
q=$(jq -r '.result // ""' "$log.json" 2>/dev/null | sed -n 's/^[[:space:]*_>`-]*QUESTION:[[:space:]*]*//p' | tail -1)
case $(printf '%s' "$q" | tr '[:upper:]' '[:lower:]') in none|none[.,:\ ]*|n/a*|-|"") q="" ;; esac   # "QUESTION: none." is not a question
# PERMISSION: a denied call the lead must approve or refuse (rc 4). Also in .ask so the crew pane raises a hand.
perm=$(jq -r '.result // ""' "$log.json" 2>/dev/null | sed -n 's/^[[:space:]*_>`-]*PERMISSION:[[:space:]*]*//p' | tail -1)
case $(printf '%s' "$perm" | tr '[:upper:]' '[:lower:]') in none|none[.,:\ ]*|n/a*|-|"") perm="" ;; esac   # "PERMISSION: none needed." asks nothing
[ -n "$perm" ] && q="PERMISSION: $perm"
[ -n "$q" ] && printf '%s\n' "$q" > "$log.ask"
secs=$(( $(date +%s) - start ))
if ! jq -e . "$log.json" >/dev/null 2>&1; then
  echo "$rc" > "$log.done"
  echo "cw: worker produced no JSON (rc=$rc, 142 = timeout)"; tail -5 "$log.err"
  echo "[cw $role $model rc=$rc ${secs}s log=$log.err]" >&2; exit $(( rc ? rc : 1 ))
fi
jq -r '.result // "(no result: \(.subtype))"' "$log.json"
acc=""
if [ -n "$accept" ] && jq -e '.is_error | not' "$log.json" >/dev/null && [ -z "$q" ]; then
  # .done waits for the acceptance run, so the crew pane shows the worker as "testing" meanwhile
  printf '{"e":"accept","t":%s}\n' "$(( $(date +%s) * 1000 ))" >> "$log.events"
  (cd "$dir" && tlimit "${CW_ACCEPT_TMO:-1800}" bash -c "$accept") > "$log.accept" 2>&1
  arc=$?; why="rc=$arc"
  # Some runners (Godot) exit 0 when a test fails or does not load: failure lines count too. CW_ACCEPT_FAIL_RE= turns it off.
  fre=${CW_ACCEPT_FAIL_RE-'^\s*(FAIL\b(?!:? *0\b)|SCRIPT ERROR)'}
  if [ $arc -eq 0 ] && [ -n "$fre" ] && ! perl -e '$r = shift; while (<>) { exit 1 if /$r/ }' "$fre" "$log.accept"; then
    arc=1; why=output
  fi
  if [ $arc -eq 0 ]; then acc=" accept=pass"; else
    acc=" accept=FAIL($why)"
    printf '\n--- acceptance FAILED (%s): %s\n' "$why" "$accept"; tail -20 "$log.accept"
  fi
  printf '{"e":"accept_end","ok":%s,"rc":%s,"t":%s}\n' "$([ $arc -eq 0 ] && echo true || echo false)" "$arc" "$(( $(date +%s) * 1000 ))" >> "$log.events"
fi
echo "$rc" > "$log.done"
[ -n "$wtname" ] && echo "[cw WT $wtname dir=$dir  merge: cwwt diff|apply|rm $wtname]" >&2
jq -r --arg r "$role" --arg e "$effort" --arg es "$effort_src" --arg rc "$rc" --arg s "$secs" --arg l "$log.json" '
  "[cw \($r) \(.modelUsage|keys|join(",")) effort=\($e)(\($es)) rc=\($rc) \(.subtype) sid=\(.session_id) turns=\(.num_turns)"
  + " new_in=\(.usage.input_tokens + .usage.cache_creation_input_tokens) cache_r=\(.usage.cache_read_input_tokens) out=\(.usage.output_tokens)"
  + " denied=\(.permission_denials|length) \($s)s\($a) log=\($l)]"' --arg a "$acc" "$log.json" >&2
jq -e '.is_error | not' "$log.json" >/dev/null || exit $(( rc ? rc : 1 ))
if [ -n "$perm" ]; then
  echo "[cw PERM sid=$(jq -r .session_id "$log.json") req=$perm]" >&2
  jq -r '.permission_denials[]? | "[cw DENIED \(.tool_name) \(.tool_input | tojson | .[0:300])]"' "$log.json" >&2
  exit 4
fi
if [ -n "$q" ]; then
  echo "[cw ASK sid=$(jq -r .session_id "$log.json") q=$q]" >&2
  exit 3
fi
exit $rc
}
